# Copiez ce fichier en .env et remplissez vos valeurs
# cp .env.example .env

# Votre adresse Gmail (celle qui ENVOIE les emails)
GMAIL_USER=paganilouis@gmail.com

# Mot de passe d'APPLICATION Gmail (pas votre vrai mot de passe)
# Générer sur : https://myaccount.google.com/apppasswords
# Validation en 2 étapes obligatoire
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email destinataire des notifications
DEST_EMAIL=paganilouis@gmail.com

# Port du serveur (3001 par défaut)
PORT=3001
